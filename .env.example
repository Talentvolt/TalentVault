DB_NAME=talentvault_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# HireNest Australia Admin Integration (server-to-server)
# TalentVault Admin Portal reads/updates HireNest employer approvals through the
# authenticated HireNest API. Never expose HIRENEST_ADMIN_API_KEY to the browser.
HIRENEST_API_BASE_URL=https://hirenest.com.au
# Server-only shared secret. Leave blank in the repo; set the real value in the
# Render dashboard (Environment) / your local .env (which is git-ignored).
HIRENEST_ADMIN_API_KEY=

# Candidate Contact Enrichment
# The extension calls the local /api/v1/enrichment/person/ endpoint, which runs
# the native TalentVault engine against the People/Email/Phone database.
#   native = native TalentVault DB engine (default, LOCAL)
#   mock   = test-only
#   http   = optional future external adapter (uses the ENRICHMENT_* values below)
ENRICHMENT_PROVIDER=native
# Base URL of an optional external enrichment service (POST {base}/api/v1/enrich).
ENRICHMENT_BASE_URL=
# Server-only secret. Never exposed to the browser.
ENRICHMENT_API_KEY=
# Optional: header name used to send the API key (defaults to X-Api-Key).
ENRICHMENT_API_KEY_HEADER=X-Api-Key
# Optional: request timeout in seconds.
ENRICHMENT_TIMEOUT=10


# ==============================================================================
# Email Configuration (Provider-Agnostic: SMTP / Resend / Amazon SES)
# ==============================================================================
# Sender identity:
EMAIL_FROM_NAME=TalentVault
EMAIL_FROM_ADDRESS=noreply@talent-vault.in
DEFAULT_FROM_EMAIL=TalentVault <noreply@talent-vault.in>
SUPPORT_EMAIL=support@talent-vault.in
SITE_DOMAIN=talent-vault.in

# Option A: SMTP Setup (e.g., standard relay or Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15

# Option B: Resend SMTP Relay (Future plug-and-play)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your_resend_api_key

# Option C: Amazon SES SMTP (Future plug-and-play)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_ses_smtp_username
# EMAIL_HOST_PASSWORD=your_ses_smtp_password
