{
    "manifest_version":  3,
    "name":  "TalentVault Candidate Importer",
    "version":  "1.0.3",
    "description":  "Import candidate profiles directly from LinkedIn or Naukri into TalentVault.",
    "permissions":  [
                        "activeTab",
                        "scripting",
                        "sidePanel",
                        "storage"
                    ],
    "host_permissions":  [
                             "https://talent-vault.in/*",
                             "https://www.talent-vault.in/*",
                             "https://*.linkedin.com/*",
                             "https://*.naukri.com/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://*.linkedin.com/*",
                                                "https://*.naukri.com/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "action":  {
                   "default_title":  "Open TalentVault Importer",
                   "default_popup":  "sidepanel.html",
                   "default_icon":  "icon.png"
               },
    "side_panel":  {
                       "default_path":  "sidepanel.html"
                   },
    "icons":  {
                  "48":  "icon.png"
              }
}