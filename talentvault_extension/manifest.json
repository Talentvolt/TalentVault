{
  "manifest_version": 3,
  "name": "TalentVault Candidate Importer",
  "version": "1.0.0",
  "key": "",
  "description": "Import candidate profiles directly from LinkedIn or Naukri into TalentVault.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.naukri.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open TalentVault Importer",
    "default_popup": "sidepanel.html",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "48": "icon.png"
  }
}
