{
    "manifest_version": 3,
    "name": "Talent Vault",
    "version": "1.0.7",
    "description": "Save candidate profiles from Naukri, LinkedIn, Apna, WorkIndia, Indeed, Foundit and any other job portal directly into Talent Vault.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "downloads"
    ],
    "host_permissions": [
        "https://talent-vault.in/*",
        "https://www.talent-vault.in/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "http://localhost/*",
        "*://*.linkedin.com/*",
        "*://*.naukri.com/*",
        "*://*.apna.com/*",
        "*://*.apna.co/*",
        "*://*.workindia.in/*",
        "*://*.indeed.com/*",
        "*://*.indeed.co.in/*",
        "*://*.foundit.in/*",
        "*://*.shine.com/*",
        "*://*.timesjobs.com/*",
        "*://*.cutshort.io/*",
        "*://*.hirist.com/*",
        "*://*.instahyre.com/*",
        "*://*.wellfound.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.linkedin.com/*",
                "*://*.naukri.com/*",
                "*://*.apna.com/*",
                "*://*.apna.co/*",
                "*://*.workindia.in/*",
                "*://*.indeed.com/*",
                "*://*.indeed.co.in/*",
                "*://*.foundit.in/*",
                "*://*.shine.com/*",
                "*://*.timesjobs.com/*",
                "*://*.cutshort.io/*",
                "*://*.hirist.com/*",
                "*://*.instahyre.com/*",
                "*://*.wellfound.com/*"
            ],
            "js": [
                "content.js",
                "widget.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "Open Talent Vault",
        "default_icon": "icon.png"
    },
    "icons": {
        "48": "icon.png"
    }
}
